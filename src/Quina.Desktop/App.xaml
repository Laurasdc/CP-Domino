<Application x:Class="Quina.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Background" Color="#111118"/>
  <SolidColorBrush x:Key="Panel" Color="#1C1C27"/>
  <SolidColorBrush x:Key="Ink" Color="#F5F4FA"/>
  <SolidColorBrush x:Key="Muted" Color="#ACAABA"/>
  <SolidColorBrush x:Key="Accent" Color="#B5A0FF"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Background}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#292635"/>
   <Setter Property="BorderBrush" Value="#484053"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,11"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="Chrome" SnapsToDevicePixels="True">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
     <Border x:Name="HoverTint" Background="#B5A0FF" Opacity="0" CornerRadius="10" IsHitTestVisible="False"/>
     <Border x:Name="PressTint" Background="#000000" Opacity="0" CornerRadius="10" IsHitTestVisible="False"/>
     <Border Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
     <Border x:Name="FocusRing" BorderBrush="#C9B8FF" BorderThickness="2" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="PressTint" Property="Opacity" Value="0.22"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8864E4" Offset="0"/><GradientStop Color="#7050CD" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="BorderBrush" Value="#9D80E8"/><Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#30283F"/><Setter Property="BorderBrush" Value="#635078"/><Setter Property="Foreground" Value="#E3D8FF"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Background" Value="#DBE5E8"/><Setter Property="Foreground" Value="#14202C"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Background" Value="#DBE5E8"/><Setter Property="Foreground" Value="#14202C"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,6,12,12"/></Style>
  <Style x:Key="DarkDurationItem" TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#EEE8FA"/><Setter Property="Background" Value="#242231"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#44365E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#51407E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DarkDuration" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EEE8FA"/><Setter Property="Background" Value="#191923"/><Setter Property="BorderBrush" Value="#51475F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="MinHeight" Value="42"/><Setter Property="ItemContainerStyle" Value="{StaticResource DarkDurationItem}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="DropToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Cursor="Hand">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="#191923" BorderBrush="#51475F" BorderThickness="1" CornerRadius="9"><Grid><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#C4B1EF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2A2538"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#A68ADE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Margin="14,10,40,10" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#242231" BorderBrush="#635078" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#B9A0EE"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Foreground" Value="#14202C"/></Style>
  <Style TargetType="TabItem"><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="20,12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Panel}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12" Margin="0,0,8,0"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#51407E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TabChrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#343342"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="MatchCard" Background="#252532" BorderBrush="#3D3B50" BorderThickness="1" CornerRadius="10" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="MatchCard" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="MatchCard" Property="Background" Value="#40365F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MatchCard" Property="Background" Value="#343045"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AccessInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Background" Value="#15151F"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#454354"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="AccessPassword" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
   <Setter Property="Background" Value="#15151F"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="#454354"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
