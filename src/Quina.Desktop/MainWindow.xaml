<Window x:Class="Quina.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Quina.Desktop" Style="{StaticResource {x:Type Window}}" Title="QUINA | Dominó Ponta de Quina" Width="1440" Height="900" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" PreviewKeyDown="Window_KeyDown">
 <Grid Margin="28,20" MaxWidth="1540" HorizontalAlignment="Stretch">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="QUINA" FontSize="32" FontWeight="Bold"/><TextBlock Text="CLUBE DE DOMINÓ" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
   <TextBlock Grid.Column="1" x:Name="ModeText" Text="Seu próximo desafio começa aqui" Margin="24,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
   <Border Grid.Column="2" Background="#1C1C27" CornerRadius="12" Padding="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
    <Button Content="Como jogar" Click="Help_Click" Style="{StaticResource Quiet}" Margin="0,0,8,0"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource Quiet}" Content="Maximizar" Click="Maximize_Click" ToolTip="Maximizar ou restaurar a janela" Margin="0,0,8,0"/>
    <Button x:Name="FullscreenButton" Style="{StaticResource Quiet}" Content="Tela cheia (F11)" Click="Fullscreen_Click" ToolTip="F11 alterna a tela cheia. Esc volta à janela." Margin="0,0,8,0"/>
    <Button x:Name="LogoutButton" Content="Sair da sessão" Click="Logout_Click" Style="{StaticResource Quiet}" Visibility="Collapsed" ToolTip="Sair da conta e voltar ao início" Margin="0,0,8,0"/>
    <Button Content="Fechar app" Click="Exit_Click" Style="{StaticResource Quiet}" Foreground="#D8ABB9" ToolTip="Fechar o aplicativo" Margin="0"/>
   </StackPanel></Border>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="{StaticResource Background}" BorderThickness="0">
   <TabItem Header="Começar" x:Name="AccessTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid Margin="0,24,0,12" MaxWidth="1180" MinHeight="530">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions>
      <Border CornerRadius="22" ClipToBounds="True" Margin="0,0,24,0">
       <Grid>
        <local:TableScene Opacity="0.65"/>
        <StackPanel Margin="40,36" VerticalAlignment="Center">
         <TextBlock Text="Vamos jogar?" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,22"/>
         <TextBlock Text="Uma boa partida&#10;começa com você" FontFamily="Segoe UI" FontSize="40" LineHeight="48" FontWeight="Bold"/>
         <TextBlock Text="Jogue contra a CPU ou reúna seu grupo online" Foreground="#D0C9E5" FontSize="16" Margin="0,18,0,28" MaxWidth="370" HorizontalAlignment="Left"/>
         <StackPanel x:Name="WelcomeTiles" Orientation="Horizontal" IsHitTestVisible="False" Margin="0,0,0,28"/>
         <Border Background="#DD22212F" CornerRadius="18" Padding="22" BorderBrush="#53476D" BorderThickness="0">
          <StackPanel>
           <TextBlock Text="Contra a CPU" FontWeight="SemiBold" FontSize="17"/>
           <TextBlock Text="Uma partida contra o computador, sem login e sem internet" Foreground="{StaticResource Muted}" Margin="0,7,0,15"/>
           <TextBlock Text="Escolha o desafio" FontSize="12" Margin="0,0,0,8"/>
           <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="EasyCpu" GroupName="CpuLevel" Content="Fácil" Foreground="{StaticResource Muted}" Margin="0,0,24,0" ToolTip="Escolhe aleatoriamente entre jogadas válidas"/>
            <RadioButton x:Name="NormalCpu" GroupName="CpuLevel" Content="Normal" IsChecked="True" Foreground="{StaticResource Muted}" ToolTip="Prioriza fechar a mão, pontuar e descartar peças pesadas"/>
           </StackPanel>
           <TextBlock Text="Duração da partida" FontSize="12"/>
           <ComboBox Style="{StaticResource DarkDuration}" x:Name="CpuDuration" SelectedIndex="0" AutomationProperties.Name="Duração da partida contra a CPU">
            <ComboBoxItem Content="Meta de 15 pontos" Tag="15"/>
            <ComboBoxItem Content="Meta de 30 pontos" Tag="30"/>
            <ComboBoxItem Content="Meta de 50 pontos" Tag="50"/>
            <ComboBoxItem Content="3 rodadas" Tag="3"/>
            <ComboBoxItem Content="5 rodadas" Tag="5"/>
            <ComboBoxItem Content="7 rodadas" Tag="7"/>
           </ComboBox>
           <TextBlock Text="Por rodadas, vence o maior placar. Placares iguais dão empate." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
           <Button Content="Jogar contra a CPU  →" Click="Demo_Click" Style="{StaticResource Secondary}" HorizontalAlignment="Stretch" Margin="0" Padding="18,12"/>
           <TextBlock x:Name="SaveStateText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
           <Button x:Name="ResumeTrainingButton" Content="Continuar minha partida  →" Click="ResumeTraining_Click" Style="{StaticResource TextAction}" Visibility="Collapsed" Margin="0,8,0,0"/>
          </StackPanel>
         </Border>
        </StackPanel>
       </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="32" CornerRadius="22">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Jogar online" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <UniformGrid Columns="3" Margin="0,0,0,28">
         <Border x:Name="EmailStep" Background="#40365F" CornerRadius="6" Padding="8,9" Margin="0,0,5,0"><TextBlock Text="1  E-mail" TextAlignment="Center" FontSize="12"/></Border>
         <Border x:Name="TokenStep" Background="#252532" CornerRadius="6" Padding="8,9" Margin="0,0,5,0"><TextBlock Text="2  Acesso" TextAlignment="Center" FontSize="12"/></Border>
         <Border x:Name="ProfileStep" Background="#252532" CornerRadius="6" Padding="8,9"><TextBlock Text="3  Jogador" TextAlignment="Center" FontSize="12"/></Border>
        </UniformGrid>
        <StackPanel x:Name="EmailPanel">
         <TextBlock Text="Entre para a próxima partida" FontSize="27" FontWeight="SemiBold"/>
         <TextBlock Text="Receba sua chave de acesso no e-mail da FIAP" Foreground="{StaticResource Muted}" Margin="0,10,0,26"/>
         <TextBlock Text="Seu e-mail FIAP" FontWeight="SemiBold" FontSize="12"/>
         <TextBox x:Name="EmailBox" Height="50" VerticalContentAlignment="Center" Style="{StaticResource AccessInput}" AutomationProperties.Name="E-mail FIAP" ToolTip="Seu endereço @fiap.com.br"/>
         <TextBlock Text="Use seu endereço @fiap.com.br" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
         <Button Content="Receber chave de acesso  →" Click="RequestToken_Click" Style="{StaticResource Primary}" Margin="0,0,0,12" Padding="16,14"/>
         <Button Content="Já tenho uma chave  →" Click="ShowToken_Click" Style="{StaticResource Secondary}" Margin="0,0,0,8"/>
         <Button Content="Continuar com acesso salvo" Click="RestoreToken_Click" Style="{StaticResource TextAction}" Margin="0"/>
        </StackPanel>
        <StackPanel x:Name="TokenPanel" Visibility="Collapsed">
         <TextBlock Text="Confira seu e-mail." FontSize="27" FontWeight="SemiBold"/>
         <TextBlock Text="Copie a chave recebida e cole abaixo. Se não encontrar, confira a pasta de spam." Foreground="{StaticResource Muted}" Margin="0,10,0,26"/>
         <TextBlock Text="Chave de acesso (token)" FontWeight="SemiBold" FontSize="12"/>
         <PasswordBox x:Name="TokenBox" Height="50" VerticalContentAlignment="Center" Style="{StaticResource AccessPassword}" AutomationProperties.Name="Chave de acesso FIAP"/>
         <CheckBox x:Name="RememberToken" Content="Lembrar meu acesso neste computador" IsChecked="True" FontSize="12" Margin="0,6,0,20"/>
         <Button Content="Continuar  →" Click="Login_Click" Style="{StaticResource Primary}" Margin="0,0,0,10" Padding="16,14"/>
         <Button Content="←  Voltar ao e-mail" Click="ShowEmail_Click" Style="{StaticResource TextAction}" Margin="0"/>
        </StackPanel>
        <StackPanel x:Name="ProfilePanel" Visibility="Collapsed">
         <TextBlock Text="Como vamos te chamar?" FontSize="27" FontWeight="SemiBold"/>
         <TextBlock x:Name="ProfileHint" Text="Escolha seu jogador para entrar no salão." Foreground="{StaticResource Muted}" Margin="0,10,0,20"/>
         <ListBox x:Name="ProfilesBox" MaxHeight="190" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Escolha seu jogador">
          <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="●" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/><TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <Button x:Name="EnterLobbyButton" Content="Entrar no salão  →" Style="{StaticResource Primary}" Click="Activate_Click" Margin="0,10,0,10" Padding="16,14"/>
         <Button Content="+  Criar meu jogador" Click="CreateProfile_Click" Style="{StaticResource Secondary}" Margin="0,0,0,12"/>
         <Expander Header="Gerenciar meu acesso" Foreground="{StaticResource Muted}" FontSize="12">
          <StackPanel Margin="0,12,0,0"><Button Content="Atualizar jogadores" Click="Profiles_Click"/><Button Content="Usar outra chave" Click="ShowToken_Click"/><Button Content="Liberar perfil neste computador" Click="Release_Click"/><TextBlock Text="Libere seu perfil antes de usá-lo em outro computador." FontSize="11"/></StackPanel>
         </Expander>
        </StackPanel>
        <TextBlock x:Name="AccessNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
      </Border>
     </Grid>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Salão de partidas" x:Name="LobbyTab" Visibility="Collapsed">
    <Grid Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
     <Border Grid.ColumnSpan="3" CornerRadius="20" ClipToBounds="True"><local:TableScene Opacity="0.55"/></Border>
     <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,12,0" Background="#F01C1C27">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="Partidas" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Um lugar à mesa espera por você." Foreground="{StaticResource Muted}" Margin="0,5,0,16"/>
        <Button Content="↻  Atualizar mesas" Click="Matches_Click" Margin="0,0,0,16"/>
       </StackPanel>
       <Grid Grid.Row="1">
        <ListBox x:Name="MatchesGrid" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="MatchSelection_Changed">
         <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="MESA ABERTA" FontSize="10" Foreground="#C0B9D1" FontWeight="SemiBold"/><TextBlock Text="{Binding PontuacaoAlvo, StringFormat='Meta de {0} pontos'}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,6"/><TextBlock Text="Uma vaga disponível" FontSize="11" Foreground="#BEB7CC"/></StackPanel>
          <TextBlock Grid.Column="1" Text="›" FontSize="26" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
         </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyMatchesText" Text="Atualize para encontrar mesas disponíveis." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/>
       </Grid>
       <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="OU ABRA SUA MESA" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/>
        <DockPanel Margin="0,8,0,0"><TextBox x:Name="TargetBox" DockPanel.Dock="Right" Text="50" Width="62" Margin="10,0,0,8"/><TextBlock Text="Meta de pontos" VerticalAlignment="Center"/></DockPanel>
        <Button x:Name="CreateMatchButton" Content="+  Criar partida" Style="{StaticResource Primary}" Click="CreateMatch_Click" Margin="0,0,0,8"/>
        <TextBlock x:Name="CreateMatchNotice" Visibility="Collapsed" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
        <Button Content="Retomar pelo ID" Click="Resume_Click" Margin="0"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Column="1" Margin="0,0,12,0">
      <local:TableScene/>
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="45,0">
        <Border Width="68" Height="68" CornerRadius="34" BorderBrush="#8C71CB" BorderThickness="1" Background="#2E2840" HorizontalAlignment="Center"><TextBlock Text="Q" FontSize="34" FontFamily="Segoe UI" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="SUA PRÓXIMA JOGADA" FontSize="11" Foreground="#BDB1D6" HorizontalAlignment="Center" Margin="0,20,0,8"/>
        <TextBlock Text="Começa aqui." FontFamily="Segoe UI" FontSize="35" HorizontalAlignment="Center"/>
        <TextBlock Text="Escolha uma mesa no salão ou crie uma partida com seu grupo." Foreground="#CCC4DD" TextAlignment="Center" Margin="0,14,0,22"/>
        <StackPanel x:Name="LobbyTiles" Orientation="Horizontal" HorizontalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock Text="Clube de dominó" FontSize="10" Foreground="#9B8CB4" HorizontalAlignment="Center" Margin="0,18,0,0"/>
       </StackPanel>
      </Grid>
     </Grid>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" Margin="0" Background="#F01C1C27">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <Border Width="76" Height="76" CornerRadius="38" BorderBrush="{StaticResource Accent}" BorderThickness="2" Background="#39304F" HorizontalAlignment="Center" Margin="0,8,0,14"><TextBlock x:Name="ProfileInitialText" Text="Q" FontFamily="Segoe UI" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock x:Name="ProfileText" Text="Seu lugar no clube" TextAlignment="Center" FontSize="19" FontWeight="SemiBold"/>
       <TextBlock Text="Escolha seu próximo desafio." TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,22"/>
       <Separator Background="#40394E" Margin="0,0,0,22"/>
       <TextBlock Text="MESA SELECIONADA" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
       <TextBlock x:Name="SelectedMatchText" Text="Selecione uma partida" FontSize="22" Margin="0,10,0,5"/>
       <TextBlock x:Name="SelectedMatchDetail" Text="As vagas são confirmadas no ingresso." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,22"/>
       <Button Content="Entrar na partida  →" Style="{StaticResource Primary}" Click="Join_Click" Margin="0,0,0,28"/>
       <Expander Header="Configuração da API" Foreground="{StaticResource Muted}"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="MappingText" Text="Confirme os códigos de próxima ação com o professor." FontSize="11" Margin="0,0,0,12"/><Button Content="Configurar ações" Click="Mapping_Click" FontSize="12" Margin="0"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Na mesa" x:Name="GameTab" Visibility="Collapsed">
    <Grid Margin="0,20,0,0" MaxHeight="720" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
     <Border CornerRadius="28" BorderBrush="#393648" BorderThickness="1" Margin="0,0,16,0">
      <Border.Background><RadialGradientBrush Center="0.5,0.4" RadiusX="0.8" RadiusY="0.9"><GradientStop Color="#323047" Offset="0"/><GradientStop Color="#20202C" Offset="1"/></RadialGradientBrush></Border.Background>
      <Grid Margin="28,24">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="OpponentNameText" Text="Aguardando adversário" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="OpponentCountText" Text="As peças do adversário ficam ocultas" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
        <StackPanel x:Name="OpponentTiles" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Border Grid.Column="2" Background="#272533" CornerRadius="16" Padding="10"><StackPanel><TextBlock x:Name="ClockLabel" Text="TEMPO" FontSize="9" Foreground="{StaticResource Muted}" TextAlignment="Center"/><TextBlock x:Name="ClockText" Text="00:00" FontSize="21" FontFamily="Consolas" TextAlignment="Center" Foreground="{StaticResource Accent}"/></StackPanel></Border>
       </Grid>
       <Grid Grid.Row="1" Margin="0,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="EndsText" Text="A MESA ESTÁ PRONTA" Foreground="#B9B5CE" FontSize="11" TextAlignment="Center"/>
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,10">
         <local:DominoBoardPanel x:Name="BoardPanel">
          <Button x:Name="LeftButton" Style="{StaticResource Secondary}" Click="Left_Click" Visibility="Collapsed" Padding="8" Margin="0" AutomationProperties.Name="Jogar na primeira ponta"><TextBlock x:Name="LeftEndLabel" Text="Encaixar aqui" TextAlignment="Center"/></Button>
          <Button x:Name="RightButton" Style="{StaticResource Secondary}" Click="Right_Click" Visibility="Collapsed" Padding="8" Margin="0" AutomationProperties.Name="Jogar na última ponta"><TextBlock x:Name="RightEndLabel" Text="Encaixar aqui" TextAlignment="Center"/></Button>
         </local:DominoBoardPanel>
        </Viewbox>
        <StackPanel Grid.Row="1" x:Name="EmptyBoardPanel" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="Q" FontFamily="Segoe UI" FontSize="64" Foreground="#5A526E" HorizontalAlignment="Center"/><TextBlock Text="Toda partida começa com uma peça." Foreground="#BEB8D1" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
        <Border x:Name="WaitingPanel" Grid.Row="1" Visibility="Collapsed" Background="#272533" CornerRadius="20" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
         <StackPanel>
          <TextBlock x:Name="WaitingTitle" Text="Aguardando outro jogador" FontSize="27" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock Text="Compartilhe o ID da mesa com quem vai jogar com você." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,12"/>
          <TextBox x:Name="WaitingMatchId" IsReadOnly="True" FontFamily="Consolas" FontSize="13" TextAlignment="Center" AutomationProperties.Name="ID da mesa"/>
          <Button Content="Copiar ID da mesa" Click="Copy_Click" Style="{StaticResource Primary}" Margin="0,14,0,0"/>
         </StackPanel>
        </Border>

       </Grid>
       <StackPanel Grid.Row="2" Margin="0,0,0,14">
        <TextBlock x:Name="MoveFeedback" TextAlignment="Center" Foreground="#80DFC4" FontSize="16" FontWeight="SemiBold" Height="28" Opacity="0"/>
        <Border x:Name="TurnBadge" Background="#39334D" CornerRadius="20" Padding="24,8" HorizontalAlignment="Center"><TextBlock x:Name="TurnText" Text="Prepare sua próxima jogada" FontWeight="SemiBold" FontSize="16"/></Border>
        <TextBlock x:Name="ActionText" Text="Crie ou entre em uma partida." TextAlignment="Center" Foreground="#C9C4D9" FontSize="12" Margin="0,8,0,8"/>

       </StackPanel>
       <Border Grid.Row="3" Background="#F0191923" CornerRadius="18" Padding="18,12" BorderBrush="#474158" BorderThickness="1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,16,0"><TextBlock x:Name="HandText" Text="SUA MÃO" Foreground="#BFB6D6" FontSize="12" Margin="0,0,0,10"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,5"><StackPanel x:Name="HandPanel" Orientation="Horizontal" HorizontalAlignment="Center"/></ScrollViewer></StackPanel>
         <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="BuyButton" Content="+  Comprar" Style="{StaticResource Primary}" Click="Buy_Click" Margin="0,0,0,8"/><Button x:Name="PassButton" Content="Passar vez" Click="Pass_Click" Margin="0"/></StackPanel>
        </Grid>
       </Border>
      </Grid>
     </Border>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Button x:Name="BackButton" Content="← Voltar ao início" Click="Back_Click" Style="{StaticResource TextAction}" Margin="0,0,0,8"/>
       <Button x:Name="RestartTrainingButton" Content="↻ Reiniciar partida" Click="RestartTraining_Click" Style="{StaticResource Secondary}" Visibility="Collapsed" Margin="0,0,0,8"/>
       <Button x:Name="EndTrainingButton" Content="Encerrar partida" Click="EndTraining_Click" Style="{StaticResource Secondary}" Foreground="#E7ACBD" Visibility="Collapsed" ToolTip="Descartar a partida contra a CPU e voltar ao início" Margin="0,0,0,20"/>
       <TextBlock Text="NESTA PARTIDA" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold" Margin="0,6,0,14"/>
       <StackPanel x:Name="ScoreCards"/>
       <TextBlock x:Name="ScoreText" Visibility="Collapsed"/>
       <Button x:Name="StartButton" Content="Iniciar partida  →" Style="{StaticResource Primary}" Click="Start_Click" Margin="0,0,0,12"/>
       <Button x:Name="HintButton" Content="Dica de jogada" Click="Suggest_Click" Margin="0,0,0,12"/>
       <CheckBox x:Name="AutoBox" Content="Jogar automaticamente" Click="Auto_Click" FontSize="12" Margin="0,0,0,18"/>
       <Button x:Name="RetryButton" Content="Repetir ação pendente" Click="Retry_Click" FontSize="11" Margin="0,0,0,14"/>
       <Expander Header="Sobre esta partida" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="LocalRulesText" Visibility="Collapsed" Text="Modo local contra a CPU. Meta de 15 pontos. Ao terminar uma rodada, quem tiver a menor soma nas peças restantes ganha 1 ponto extra; empate não dá bônus. Essa regra local pode diferir do modo online." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><TextBlock x:Name="MatchText" Text="Nenhuma partida selecionada" FontSize="11" Margin="0,0,0,12"/><Button Content="Copiar ID da mesa" Click="Copy_Click" FontSize="12" Margin="0,0,0,8"/><Button Content="Resultado e histórico" Click="Result_Click" FontSize="12" Margin="0"/></StackPanel></Expander>
       <Expander Header="Atividade da mesa" Foreground="{StaticResource Muted}" FontSize="12"><TextBox x:Name="LogBox" IsReadOnly="True" Height="150" Background="#15151F" Foreground="#B8B0C7" FontFamily="Consolas" FontSize="10" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Expander>
      </StackPanel>
     </ScrollViewer>
     <Border x:Name="GameOverlay" Panel.ZIndex="10" Visibility="Collapsed" Background="#D90D0C16" CornerRadius="28" Margin="0,0,16,0">
      <Grid>
        <Border x:Name="FinishPanel"  Visibility="Collapsed" Background="#252232" CornerRadius="22" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
         <StackPanel>
          <TextBlock Text="FIM DE PARTIDA" Foreground="{StaticResource Accent}" TextAlignment="Center" FontSize="11"/>
          <TextBlock x:Name="FinishTitle" FontSize="32" FontWeight="Bold" TextAlignment="Center" Margin="0,10"/>
          <TextBlock x:Name="FinishScore" TextAlignment="Center" FontSize="20" Margin="0,0,0,20"/>
          <TextBlock x:Name="FinishDetail" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/>
          <Button x:Name="PlayAgainButton" Content="Jogar novamente" Click="RestartTraining_Click" Style="{StaticResource Primary}"/>
          <Button x:Name="FinishBackButton" Content="Voltar ao início" Click="Back_Click" Style="{StaticResource Secondary}"/>
          <Button Content="Ver histórico" Click="Result_Click" Style="{StaticResource TextAction}"/>
         </StackPanel>
        </Border>
       <Border x:Name="RoundPanel" Visibility="Collapsed" Background="#252232" CornerRadius="22" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
        <StackPanel>
         <TextBlock x:Name="RoundTitle" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
         <TextBlock x:Name="RoundDetail" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,16"/>
         <Button x:Name="NextRoundButton" Content="Próxima rodada" Click="NextRound_Click" Style="{StaticResource Primary}"/>
         <Button Content="Voltar ao início" Click="Back_Click" Style="{StaticResource TextAction}"/>
        </StackPanel>
       </Border>
      </Grid>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="BusyText" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" Margin="16,0,0,0"/><TextBlock x:Name="NoticeText" Text="Escolha como quer jogar" Foreground="{StaticResource Muted}"/></DockPanel>
 </Grid>
</Window>
